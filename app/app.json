{
  "expo": {
    "name": "SadakYatra",
    "slug": "sadakyatra",
    "version": "0.1.0",
    "sdkVersion": "57.0.0",
    "orientation": "portrait",
    "icon": "./assets/loveable/icon-512.png",
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#0A0A0A"
    },
    "android": {
      "package": "com.sadakyatra.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/loveable/icon-512.png",
        "backgroundColor": "#0A0A0A"
      }
    },
    "plugins": [
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#FFCC00"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SadakYatra needs your photos to upload vehicle documents and car pictures.",
          "cameraPermission": "SadakYatra uses the camera to photograph vehicle documents."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SadakYatra uses your location to set the pickup point and, for drivers, to receive nearby bookings and show the route."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3433374d-a997-4839-80c7-4d242f1fd44d"
      }
    },
    "owner": "sadakyatra",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0A"
  }
}
