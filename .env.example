# Is file ko copy karke ".env.local" naam do, aur apni Supabase values daalo.
# Supabase → Project Settings → API mein milengi.
NEXT_PUBLIC_SUPABASE_URL=https://XXXXXXXX.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Drivers ke accounts banane ke liye (SIRF server pe — isme NEXT_PUBLIC_ kabhi mat lagana).
# Supabase → Project Settings → API → service_role / secret key
SUPABASE_SERVICE_ROLE_KEY=
